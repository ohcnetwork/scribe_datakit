# Copy to .env and fill in. .env is git-ignored.
#
# Data lives on a GCS bucket, not in this repo. Only the maintainer data-sync
# targets (make pull/push/release) touch the bucket for writes, and they use your
# LOCAL gcloud credentials — run once:  gcloud auth application-default login
# The app at runtime and the CI build never use credentials; they read the public
# bucket over HTTPS.

# Push/pull target — where the dataset is stored (write access = maintainer only).
GCS_BUCKET=gs://scribe-data

# Public read URL — the Cloudflare-fronted bucket. Used by the build to bake
# metadata.json into the bundle, and set as VITE_ASSET_BASE so the app fetches
# audio/peaks from it at runtime. No credentials.
PUBLIC_BASE=https://data.example.com

# Used by `make setup-bucket` (one-time bucket provisioning). Optional — these are
# the defaults if left unset.
REGION=us-central1
CORS_ORIGIN=*
